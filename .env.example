# === Supabase ===
# Public (safe for the browser) — project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — NEVER expose to the client/browser bundle.
# Used exclusively inside API route handlers / server components for
# operations that must bypass RLS under controlled, verified conditions
# (e.g. admin actions, quota checks, generating signed URLs).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Supabase Storage bucket used for user files (private bucket).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=nuvemx-files

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NuvemX

# Default storage quota (bytes) applied to new users when no plan/subscription exists yet.
DEFAULT_STORAGE_QUOTA_BYTES=5368709120

# Max single-file upload size (bytes) enforced server-side, independent of plan quota.
MAX_UPLOAD_SIZE_BYTES=2147483648

# Number of days a trashed item is kept before being eligible for permanent deletion.
TRASH_RETENTION_DAYS=30

# === Pagamentos (Stripe) ===
# AMBAS são server-only. Nunca prefixe com NEXT_PUBLIC_: esse prefixo
# embute o valor no bundle do navegador, e qualquer visitante passaria a
# poder cobrar em seu nome e forjar webhooks.
#
# Painel da Stripe → Developers → API keys. Use sk_test_ enquanto testa.
STRIPE_SECRET_KEY=

# Painel da Stripe → Developers → Webhooks → seu endpoint → Signing secret.
# É o segredo que valida o HMAC de cada webhook. Sem ele, /api/webhooks/stripe
# rejeita tudo — que é o comportamento correto quando não há como verificar.
STRIPE_WEBHOOK_SECRET=

MERCADOPAGO_ACCESS_TOKEN=

# === Security ===
# Random 32+ char secret used to sign share-link password hashes/tokens if needed.
# ALSO used to derive the AES-256-GCM key that encrypts VPN peer private keys
# at rest. Changing it makes every existing VPN profile undecryptable — rotate
# only if you are prepared to have users re-create their devices.
APP_SECRET=change-me-to-a-long-random-string

# === VPN ===
# No env vars are needed here: the WireGuard nodes are rows in the
# `vpn_servers` table, registered by an admin (see docs/VPN.md). The app is
# the control plane only — the actual tunnel runs on your own VPS.
