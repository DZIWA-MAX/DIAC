# === Supabase ===
# Public (safe for the browser) — project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — NEVER expose to the client/browser bundle.
# Used exclusively inside API route handlers / server components for
# operations that must bypass RLS under controlled, verified conditions
# (e.g. admin actions, quota checks, generating signed URLs).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Supabase Storage bucket used for user files (private bucket).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=nuvemx-files

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NuvemX

# Default storage quota (bytes) applied to new users when no plan/subscription exists yet.
DEFAULT_STORAGE_QUOTA_BYTES=5368709120

# Max single-file upload size (bytes) enforced server-side, independent of plan quota.
MAX_UPLOAD_SIZE_BYTES=2147483648

# Number of days a trashed item is kept before being eligible for permanent deletion.
TRASH_RETENTION_DAYS=30

# === Payments (architecture only — no gateway wired up yet) ===
# Fill these in when integrating a real provider (Stripe, Mercado Pago, etc).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# === Security ===
# Random 32+ char secret used to sign share-link password hashes/tokens if needed.
APP_SECRET=change-me-to-a-long-random-string
